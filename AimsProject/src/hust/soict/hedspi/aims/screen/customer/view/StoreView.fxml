<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hust.soict.hedspi.aims.screen.customer.controller.StoreController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <!-- Menu Bar -->
            <MenuBar>
              <menus>
                <Menu mnemonicParsing="false" text="Options">
                  <items>
                    <MenuItem fx:id="viewStoreMenuItem" mnemonicParsing="false" onAction="#viewStore" text="View Store" />
                    <MenuItem fx:id="viewCartMenuItem" mnemonicParsing="false" onAction="#viewCart" text="View Cart" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
            
            <!-- Title and Cart Info -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Label text="AIMS Store">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="cartButton" mnemonicParsing="false" onAction="#viewCart" text="View Cart" />
                  <Label fx:id="cartItemsLabel" text="0 items in cart" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>
            </HBox>
            
            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Search:" />
                  <TextField fx:id="searchField" prefWidth="300.0" promptText="Enter title to search..." />
                  <Button fx:id="searchButton" mnemonicParsing="false" onAction="#searchMedia" text="Search" />
                  <Button fx:id="clearSearchButton" mnemonicParsing="false" onAction="#clearSearch" text="Clear" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
         <content>
            <GridPane fx:id="mediaGrid" hgap="20.0" vgap="20.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </GridPane>
         </content>
      </ScrollPane>
   </center>
</BorderPane> 